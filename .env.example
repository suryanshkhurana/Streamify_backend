# =============================================================================
# Streamify — Root .env.example
#
# Copy this file to .env (git-ignored) and fill in real values.
# This file is loaded by docker-compose.yml via ${VAR} interpolation.
# =============================================================================

# ── Shared Secrets ────────────────────────────────────────────────────────────
# Used by auth-service, api-gateway, catalog-service, stream-service,
# playlist-service, user-service, and recommendation-service.
# Must be the SAME value in every service.
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_32_chars_long

# ── CORS / Frontend ────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URIs must include GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/oauth/google/callback

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# MongoDB is NOT run locally in Docker — use Atlas connection strings.
# Each service connects to its own database inside the same cluster.
MONGODB_URI_USERS=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/streamify-users?retryWrites=true&w=majority
MONGODB_URI_PLAYLISTS=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/streamify-playlists?retryWrites=true&w=majority
MONGODB_URI_RECOMMENDATIONS=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/streamify-recommendations?retryWrites=true&w=majority

# ── AWS (S3 + CloudFront) ─────────────────────────────────────────────────────
# Used by catalog-service (upload), stream-service (HLS), and user-service (avatars).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=streamify-music-storage

# CloudFront (stream-service) — leave blank to fall back to plain S3 URLs in dev
CLOUDFRONT_DOMAIN=https://your_distribution_id.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=your_cloudfront_key_pair_id
# Base64-encoded RSA private key PEM (no newlines)
CLOUDFRONT_PRIVATE_KEY=your_base64_encoded_pem_private_key

# ── Email (Notification Service) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=noreply@streamify.app

# ── Firebase (Push Notifications) ─────────────────────────────────────────────
# Get from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com

# ── ClickHouse (Analytics Service) ───────────────────────────────────────────
# Leave as default if running ClickHouse locally; point to cloud instance in prod
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=streamify_analytics
