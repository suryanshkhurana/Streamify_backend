# stream-service environment variables
# Copy this file to .env.local and fill in real values

S3_BUCKET=streamify-audio
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
CLOUDFRONT_DOMAIN=https://cdn.streamify.app
CLOUDFRONT_KEY_PAIR_ID=your_cloudfront_key_pair_id
# Base64-encoded CloudFront private key (PEM)
CLOUDFRONT_PRIVATE_KEY=your_base64_encoded_private_key
RABBITMQ_URL=amqp://streamify:streamify_dev_password@localhost:5672
PORT=3004
NODE_ENV=development
LOG_LEVEL=info
