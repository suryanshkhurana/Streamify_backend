# user-service environment variables
# Copy this file to .env.local and fill in real values

MONGODB_URI=mongodb://localhost:27017/streamify-users
REDIS_URL=redis://localhost:6379
S3_BUCKET=streamify-assets
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
RABBITMQ_URL=amqp://streamify:streamify_dev_password@localhost:5672
PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/streamify-users?retryWrites=true&w=majority
