# auth-service environment variables
# Copy this file to .env.local and fill in real values (never commit .env.local)

DATABASE_URL=postgresql://streamify:streamify_dev_password@localhost:5432/streamify_auth
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_32_chars
REDIS_URL=redis://localhost:6379

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must include GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# URL that Google redirects to after the user grants consent.
# Must be registered in the Google Cloud Console as an Authorised redirect URI.
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/oauth/google/callback

# ─── Frontend ─────────────────────────────────────────────────────────────────
# The SPA origin. The Passport callback redirects here with ?accessToken=...
# The SPA must read the token from the URL on mount and strip it with
# history.replaceState() immediately.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

PORT=3001
NODE_ENV=development
LOG_LEVEL=info
RABBITMQ_URL=amqp://streamify:streamify_dev_password@localhost:5672
