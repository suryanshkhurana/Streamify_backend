
# Required: MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/streamify-playlists

# Port this service listens on (default: 3006)
PORT=3006

# JWT secret — must match auth-service and api-gateway
JWT_SECRET=dev_jwt_secret_change_in_prod

# CORS origin (Vite dev server)
CORS_ORIGIN=http://localhost:5173
