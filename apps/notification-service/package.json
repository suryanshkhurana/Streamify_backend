{
  "name": "@streamify/notification-service",
  "version": "0.0.0",
  "private": true,
  "description": "Streamify Notification Service – email + web push via RabbitMQ events (port 3008, internal)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@streamify/shared-middleware": "workspace:*",
    "@streamify/shared-types": "workspace:*",
    "@streamify/shared-utils": "workspace:*",
    "amqplib": "^0.10.4",
    "firebase-admin": "^12.3.0",
    "nodemailer": "^6.9.14",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/node": "^20.14.11",
    "@types/nodemailer": "^6.4.15",
    "rimraf": "^6.0.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
