# catalog-service environment variables
# Copy this file to .env.local and fill in real values

DATABASE_URL=postgresql://streamify:streamify_dev_password@localhost:5432/streamify_catalog
S3_BUCKET=streamify-audio
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
RABBITMQ_URL=amqp://streamify:streamify_dev_password@localhost:5672
PORT=3003
NODE_ENV=development
LOG_LEVEL=info
