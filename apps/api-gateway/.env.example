# Required
PORT=3000
NODE_ENV=development

# Must match the JWT_SECRET in auth-service — used to verify tokens at the gateway
JWT_SECRET=your_jwt_secret_here

# CORS — Vite dev server
CORS_ORIGIN=http://localhost:5173

# Redis — for the rate-limiter store
REDIS_URL=redis://localhost:6379

# Upstream service ports (defaults match each service's dev port)
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
CATALOG_SERVICE_PORT=3003
STREAM_SERVICE_PORT=3004
SEARCH_SERVICE_PORT=3005
PLAYLIST_SERVICE_PORT=3006
RECOMMENDATION_SERVICE_PORT=3007
